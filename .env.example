# ======================================================
# CryptoArth Strategy Engine - ENV EXAMPLE
# Copy to .env or .env.production
# ======================================================

# ------------------------------
# Environment
# ------------------------------
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO

# ------------------------------
# URLs
# ------------------------------
BASE_API_URL=http://localhost:8000
STRATEGY_ENGINE_BASE_URL=http://localhost:8000
STRATEGY_ENGINE_FRONTEND_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ------------------------------
# Database (MySQL / AWS RDS)
# ------------------------------
DB_ENGINE=mysql
DB_HOST=your_db_host
DB_PORT=3306
DB_NAME=tradearth_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL=true

# ------------------------------
# Redis (Core + OTP + Copilot)
# ------------------------------
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_DB=0
REDIS_SSL=false
# REDIS_PASSWORD=optional_redis_password

# ------------------------------
# AI Builder / Copilot (Uses same Redis)
# ------------------------------
AI_BUILDER_REDIS_HOST=your_redis_host
AI_BUILDER_REDIS_PORT=6379
AI_BUILDER_REDIS_DB=0
# AI_BUILDER_REDIS_PASSWORD=optional_redis_password

COPILOT_SESSION_TTL=86400
COPILOT_HISTORY_TTL=604800

# ------------------------------
# External APIs
# ------------------------------
DELTA_BASE_URL=https://api.india.delta.exchange

# ------------------------------
# OpenAI
# ------------------------------
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=2

# ------------------------------
# Auth / JWT
# ------------------------------
AUTH_BACKEND_URL=https://trade-api.cryptoarth.in
JWT_ALGORITHM=HS256

# ------------------------------
# Razorpay
# ------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_MERCHANT_ID=your_merchant_id

# ------------------------------
# OTP Providers
# ------------------------------
aisensy_api_key=your_aisensy_api_key
aisensy_campaign_name=your_campaign_name
aisensy_user_name=your_company_name

msg91_flow_id=your_msg91_flow_id
msg91_auth_key=your_msg91_auth_key

# ------------------------------
# Limits
# ------------------------------
REQUEST_TIMEOUT=30
MAX_STRATEGY_GENERATION_TOKENS=4000
